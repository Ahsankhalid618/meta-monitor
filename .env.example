# ── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meta_monitor?schema=public"
# Set to "true" for managed Postgres with self-signed TLS certs (e.g. Railway, Heroku).
# Leave "false" (or unset) for a plain local Postgres without SSL.
DATABASE_SSL="false"

# ── AI (Groq) ──────────────────────────────────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Groq free tier: use batch=1, delay=2000ms to stay under rate limits
LLM_CLASSIFY_BATCH="1"
LLM_CLASSIFY_DELAY_MS="2000"
LLM_MAX_CONTENT_CHARS="4000"
LLM_QUOTA_COOLDOWN_MS="900000"
LLM_CLASSIFY_INTERVAL_MS="300000"

# ── Notifications ──────────────────────────────────────────
SLACK_WEBHOOK_URL=""
RESEND_API_KEY=""
ALERT_EMAIL_TO=""
ALERT_EMAIL_FROM="alerts@example.com"

# ── Pipeline tuning ────────────────────────────────────────
# Default poll interval in seconds (per-source override lives in the DB).
POLL_INTERVAL="300"
# Event-merge similarity threshold (0-1).
SIMILARITY_THRESHOLD="0.90"

# ── Optional ───────────────────────────────────────────────
# Raises GitHub API rate limits for the github/ collector.
GITHUB_TOKEN=""

# ── Server / runtime ───────────────────────────────────────
PORT="3000"
NODE_ENV="development"
LOG_LEVEL="info"
